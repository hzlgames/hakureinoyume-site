[Unit]
Description=Remove expired ZJU download artifacts
After=network.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/hakureinoyume-site
EnvironmentFile=/etc/hakureinoyume-site.env
ExecStart=/usr/local/bin/node --import tsx scripts/zju-maintenance.ts --cleanup-only
TimeoutStartSec=300
