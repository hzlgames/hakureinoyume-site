[Unit]
Description=Hakurei no Yume Next.js app
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hakureinoyume-site
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/hakureinoyume-site.env
ExecStart=/usr/local/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
