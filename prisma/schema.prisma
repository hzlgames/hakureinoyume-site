generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean
  image             String?
  createdAt         DateTime
  updatedAt         DateTime
  role              String?
  banned            Boolean?
  banReason         String?
  banExpires        DateTime?
  sessions          Session[]
  accounts          Account[]
  auditLogs         AdminAuditLog[]    @relation("AuditActor")
  neteaseAccount    NeteaseAccount?
  webMusicPlaylists WebMusicPlaylist[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

model NeteaseAccount {
  id               String    @id @default(cuid())
  userId           String    @unique
  neteaseUserId    String?
  nickname         String?
  avatarUrl        String?
  cookieCiphertext String
  cookieIv         String
  cookieTag        String
  profile          Json?
  loginStatus      String    @default("active")
  lastValidatedAt  DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([neteaseUserId])
  @@index([loginStatus])
}

model WebMusicPlaylist {
  id        String                 @id @default(cuid())
  userId    String
  name      String                 @default("网页歌单")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs     WebMusicPlaylistSong[]

  @@unique([userId, name])
  @@index([userId])
}

model WebMusicPlaylistSong {
  id         String           @id @default(cuid())
  playlistId String
  songId     String
  name       String
  artists    String
  album      String?
  coverUrl   String?
  duration   Int?
  position   Int              @default(0)
  addedAt    DateTime         @default(now())
  playlist   WebMusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId])
  @@index([playlistId, position])
  @@index([songId])
}
