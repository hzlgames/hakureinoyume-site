generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  asrQuotaExempt Boolean @default(false)
  liveSubtitleViewers ZjuLiveSubtitleViewer[]
  liveSubtitleGrants ZjuLiveSubtitleGrant[]
  twoFactorAccounts TwoFactorAccount[]
  zjuToolStates ZjuToolState[]
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean
  image             String?
  createdAt         DateTime
  updatedAt         DateTime
  role              String?
  banned            Boolean?
  banReason         String?
  banExpires        DateTime?
  sessions          Session[]
  accounts          Account[]
  auditLogs         AdminAuditLog[]    @relation("AuditActor")
  neteaseAccount    NeteaseAccount?
  zjuAccount        ZjuAccount?
  zjuToolJobs       ZjuToolJob[]
  webMusicPlaylists WebMusicPlaylist[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

model NeteaseAccount {
  id               String    @id @default(cuid())
  userId           String    @unique
  neteaseUserId    String?
  nickname         String?
  avatarUrl        String?
  cookieCiphertext String
  cookieIv         String
  cookieTag        String
  profile          Json?
  loginStatus      String    @default("active")
  lastValidatedAt  DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([neteaseUserId])
  @@index([loginStatus])
}

model ZjuAccount {
  id                 String    @id @default(cuid())
  userId             String    @unique
  username           String
  passwordCiphertext String
  passwordIv         String
  passwordTag        String
  pintiaCiphertext   String?
  pintiaIv           String?
  pintiaTag          String?
  lastValidatedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

model ZjuToolJob {
  replayTranscriptId String?
  replayTranscript ZjuReplayTranscript? @relation(fields: [replayTranscriptId], references: [id], onDelete: SetNull)
  id          String    @id @default(cuid())
  userId      String
  tool        String
  status      String    @default("queued")
  input       Json?
  output      Json?
  logs        String    @default("")
  error       String?
  workDir     String?
  startedAt   DateTime?
  finishedAt  DateTime?
  exitCode    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tool])
  @@index([replayTranscriptId, status])
  @@index([status])
  @@index([createdAt])
}

model WebMusicPlaylist {
  id        String                 @id @default(cuid())
  userId    String
  name      String                 @default("网页歌单")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs     WebMusicPlaylistSong[]

  @@unique([userId, name])
  @@index([userId])
}

model WebMusicPlaylistSong {
  id         String           @id @default(cuid())
  playlistId String
  songId     String
  name       String
  artists    String
  album      String?
  coverUrl   String?
  duration   Int?
  position   Int              @default(0)
  addedAt    DateTime         @default(now())
  playlist   WebMusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId])
  @@index([playlistId, position])
  @@index([songId])
}

model ZjuToolState {
  userId String
  key String
  value Json
  lockedUntil DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, key])
  @@index([key])
}

model TwoFactorAccount {
  id          String   @id
  userId      String
  fingerprint String
  ciphertext  String
  iv          String
  tag         String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, createdAt])
}

// One shared classroom audio transcription per actual ZJU lesson.
model ZjuLiveSubtitle {
  id             String   @id @default(cuid())
  lessonKey      String   @unique
  courseId       String
  subId          String
  type           String
  title          String
  audioSource    String   @default("classroom")
  status         String   @default("queued")
  provider       String   @default("volcengine")
  leaseOwner     String?
  leaseUntil     DateTime?
  generation     Int      @default(0)
  attempts       Int      @default(0)
  revision       Int      @default(0)
  partial        String   @default("")
  partialStartMs Int?
  partialEndMs   Int?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  expiresAt      DateTime
  audioMs        Int      @default(0)
  billedAudioMs  Int      @default(0)
  lastSequence   Int?
  timelineMs     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cues           ZjuLiveSubtitleCue[]
  segments       ZjuLiveSubtitleSegment[]
  viewers        ZjuLiveSubtitleViewer[]
  grants         ZjuLiveSubtitleGrant[]

  @@index([status, leaseUntil])
  @@index([expiresAt])
}

model ZjuLiveSubtitleCue {
  id         String @id @default(cuid())
  subtitleId String
  key        String
  startMs    Int
  endMs      Int
  text       String
  revision   Int
  subtitle   ZjuLiveSubtitle @relation(fields: [subtitleId], references: [id], onDelete: Cascade)
  @@unique([subtitleId, key])
  @@index([subtitleId, revision])
  @@index([subtitleId, startMs])
}

model ZjuLiveSubtitleSegment {
  id         String @id @default(cuid())
  subtitleId String
  sequence   Int
  startMs    Int
  durationMs Int
  observedAt DateTime
  subtitle   ZjuLiveSubtitle @relation(fields: [subtitleId], references: [id], onDelete: Cascade)
  @@unique([subtitleId, sequence])
}

model ZjuLiveSubtitleViewer {
  subtitleId String
  userId     String
  clientId   String
  lastSeenAt DateTime @default(now())
  subtitle   ZjuLiveSubtitle @relation(fields: [subtitleId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([subtitleId, userId, clientId])
  @@index([subtitleId, lastSeenAt])
}

model ZjuLiveSubtitleDailyUsage {
  day     String @id
  audioMs Int @default(0)
  exemptAudioMs Int @default(0)
}

model ZjuLiveSubtitleGrant {
  subtitleId String
  userId String
  authorizedAt DateTime @default(now())
  subtitle ZjuLiveSubtitle @relation(fields: [subtitleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([subtitleId, userId])
}

// Permanent text cache; media and signed URLs are never persisted here.
model ZjuReplayTranscript {
  id String @id @default(cuid())
  lessonKey String @unique
  courseId String
  subId String
  title String
  status String @default("queued")
  leaseOwner String?
  leaseUntil DateTime?
  generation Int @default(0)
  durationMs Int @default(0)
  processedMs Int @default(0)
  error String?
  srt String @default("")
  txt String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs ZjuToolJob[]
  chunks ZjuReplayTranscriptChunk[]
  @@index([status, leaseUntil])
}

model ZjuReplayTranscriptChunk {
  audioStartMs Int @default(0)
  id String @id @default(cuid())
  transcriptId String
  startMs Int
  durationMs Int
  requestId String @unique
  resourceId String
  status String @default("submitting")
  cues Json?
  submittedAt DateTime @default(now())
  transcript ZjuReplayTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  @@unique([transcriptId, startMs])
}
